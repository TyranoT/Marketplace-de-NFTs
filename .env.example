# URL pública da aplicação. Crawlers de Open Graph e Twitter exigem URL
# absoluta em og:url, og:image e twitter:image. Sem esta variável as tags
# saem com caminho relativo, o que funciona no preview local mas não gera
# card ao compartilhar o link.
#
# Defina no provedor de deploy (Vercel / Netlify / Cloudflare Pages).
VITE_SITE_URL=https://exemplo.vercel.app

# Camada de mocks MSW. Ligada por padrão, inclusive no build de demonstração.
# Defina como "false" para desligar e apontar para uma API real.
VITE_ENABLE_MOCKS=true
